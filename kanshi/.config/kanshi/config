profile home_desktop {
    output "BNQ BenQ RD280UG *" {
        enable
        # Select the highest available refresh rate at native resolution.
        mode 3840x2560
        position 0,0
        transform normal
        scale 1.5
    }
}

profile laptop_dock {
    output eDP-1 disable
    output "BNQ BenQ RD280UG *" {
        mode 3840x2560@119.991Hz
        position 0,0
        scale 1.5
    }
}

profile laptop {
    output eDP-1 enable mode 2880x1920@120Hz scale 2
}

profile "fallback" {
    output * enable
}
