{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "yoloMode": false,
  "forwardingTimeoutMs": 30000,
  "permission": {
    "*": "ask",
    "mcp": "deny",
    "skill": "allow",
    "read": "allow",
    "ls": "allow",
    "grep": "allow",
    "find": "allow",
    "write": "allow",
    "edit": "allow",
    "web_search": "allow",
    "get_search_content": "allow",
    "fetch_content": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "rm *": "deny",
      "ls *": "allow",
      "tree *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "printf *": "allow",
      "wc *": "allow",
      "git *": "allow",
      "git commit *": "ask",
      "git push *": "deny",
      "git pull *": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git blame *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "gh *": "ask",
      "gh pr status *": "allow",
      "gh pr view *": "allow",
      "gh pr diff *": "allow",
      "uv *": "ask",
      "uv run *": "ask",
      "uv lock": "allow",
      "uv sync *": "allow",
      "uv run ruff *": "allow",
      "uv run ty *": "allow",
      "uv run pytest *": "allow",
      "cargo *": "ask",
      "cargo run *": "ask",
      "cargo check *": "allow",
      "cargo fmt *": "allow",
      "cargo +nightly fmt *": "allow",
      "cargo clippy *": "allow",
      "cargo +nightly clippy *": "allow",
      "cargo test *": "allow",
      "tofu *": "deny",
      "tofu fmt *": "allow",
      "tofu validate *": "allow",
      "docker *": "deny",
      "just *": "ask",
      "just check *": "allow",
      "just check-*": "allow",
      "just test *": "allow",
      "python *": "deny",
      "python3 *": "deny",
      "pip *": "deny",
      "pip3 *": "deny",
      "poetry *": "deny",
      "poetry3 *": "deny",
      "gcloud *": "deny"
    },
    "external_directory": "ask"
  }
}
