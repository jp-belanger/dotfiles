{
  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "deny",
    "skills": "allow",
    "special": "ask"
  },
  "tools": {
    "read": "allow",
    "ls": "allow",
    "grep": "allow",
    "find": "allow",
    "write": "allow",
    "edit": "allow",
    "web_search": "allow",
    "get_search_content": "allow",
    "fetch_content": "ask"
  },
  "bash": {
    "*": "ask",
    "rm *": "deny",
    "ls *": "allow",
    "tree *": "allow",
    "grep *": "allow",
    "rg *": "allow",
    "find *": "allow",
    "cat *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "printf *": "allow",
    "wc *": "allow",
    "git status *": "allow",
    "git diff *": "allow",
    "git log *": "allow",
    "git show *": "allow",
    "git add *": "ask",
    "git commit *": "ask",
    "git push *": "deny",
    "git pull *": "deny",
    "gh *": "ask",
    "gh pr status *": "allow",
    "gh pr view *": "allow",
    "gh pr diff *": "allow",
    "uv *": "ask",
    "uv lock": "allow",
    "uv sync *": "allow",
    "uv run ruff *": "allow",
    "uv run ty *": "allow",
    "uv run pytest *": "allow",
    "cargo *": "ask",
    "cargo check *": "allow",
    "cargo fmt *": "allow",
    "cargo +nightly fmt *": "allow",
    "cargo clippy *": "allow",
    "cargo +nightly clippy *": "allow",
    "cargo test *": "allow",
    "tofu *": "deny",
    "tofu plan *": "allow",
    "tofu fmt *": "allow",
    "tofu validate *": "allow",
    "tofu plan *": "deny",
    "docker *": "deny",
    "just *": "ask",
    "just check *": "allow",
    "just check-*": "allow",
    "just test *": "allow",
    "python *": "deny",
    "python3 *": "deny",
    "pip *": "deny",
    "pip3 *": "deny",
    "poetry *": "deny",
    "poetry3 *": "deny"
  }
}
